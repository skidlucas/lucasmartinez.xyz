---
import { Font } from 'astro:assets';

interface AlternateLocale {
  lang: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  alternates?: AlternateLocale[];
  image?: string;
  noindex?: boolean;
}

const {
  title = "lucas martinez — software engineer",
  description = "software engineer based in the south of france. backend enthusiast, problem solver, trying to be the guy you can count on to get things done.",
  lang = "en",
  alternates = [],
  image = "/og.png",
  noindex = false,
}: Props = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const localeByLang: Record<string, string> = {
  en: 'en_US',
  fr: 'fr_FR',
  ko: 'ko_KR',
};
const locale = localeByLang[lang] ?? 'en_US';
const alternateLocales = alternates.filter((alternate) => alternate.lang !== lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-mono" preload />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />} 

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale} />
    {alternateLocales.map((alternate) => (
      <meta property="og:locale:alternate" content={localeByLang[alternate.lang] ?? 'en_US'} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Robots -->
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!--
      Critical theme bootstrap.
      Keep this inline in <head> so the browser applies the saved/system theme
      before first paint. The ThemeToggle module only wires the click handler.
    -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = savedTheme || (prefersDark ? 'dark' : 'light');

          document.documentElement.dataset.theme = theme;
        } catch {
          // If storage is unavailable, leave the default light theme in place.
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #0a0a0a;
    --fg-muted: #6b6b6b;
    --text-2: #333333;
    --text-3: #555555;
    --pill-text: #444444;
    --border: #e2e2e0;
    --pill-border: #dcdcda;
    --header-border: #e6e6e4;
    --header-bg: rgba(250, 250, 249, 0.88);
    --card-bg: #ffffff;
    --transition: 0.2s ease;
  }

  [data-theme="dark"] {
    --bg: #0a0a0a;
    --fg: #e8e8e6;
    --fg-muted: #8a8a8a;
    --text-2: #b5b5b3;
    --text-3: #a0a09e;
    --pill-text: #a8a8a6;
    --border: #242424;
    --pill-border: #2a2a2a;
    --header-border: #242424;
    --header-bg: rgba(10, 10, 10, 0.85);
    --card-bg: #0f0f0f;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-mono), monospace;
    font-size: 14px;
    line-height: 1.7;
    background: var(--bg);
    color: var(--fg);
    transition: background var(--transition), color var(--transition);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .section-title {
    font-size: 12px;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .page-title {
    font-size: 64px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .page-subtitle {
    font-size: 16px;
    color: var(--fg-muted);
  }

  /* Underlined text link whose hover inverts colors (contact links, /now footer). */
  .link {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--fg);
  }

  .link:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 639px) {
    .container {
      padding: 0 20px;
    }

    .page-title {
      font-size: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body {
      transition: none;
    }
  }
</style>

---
import SubPageShell from '../layouts/SubPageShell.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/translations';
import { getNowItems } from '../data/profile';

const lang = 'en';
const t = useTranslations(lang);
const items = getNowItems(t);
---

<SubPageShell
  title={`${t('now.title')} — ${t('hero.name')}`}
  description={t('now.subtitle')}
  lang={lang}
>
  <div class="intro">
    <h1 class="page-title">{t('now.title')}</h1>
    <p class="page-subtitle">{t('now.subtitle')}</p>
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      {t('now.lastUpdated')}: {t('now.lastUpdatedAt')}
    </p>
  </div>

  <dl class="list">
    {items.map((item) => (
      <div class="row">
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>

  <Footer lang={lang}>
    <p>
      {t('now.inspired.title')}{' '}
      <a href="https://nownownow.com" class="link" target="_blank" rel="noopener noreferrer">nownownow.com</a>
    </p>
  </Footer>
</SubPageShell>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: fadeUp 0.6s ease both;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--fg-muted);
  }

  .dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg);
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--fg);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .list {
    border-top: 1px solid var(--border);
    animation: fadeUp 0.6s 0.15s ease both;
  }

  .row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  dt {
    padding-top: 2px;
    font-size: 12px;
    color: var(--fg-muted);
  }

  dd {
    text-wrap: pretty;
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro,
    .dot::after,
    .list {
      animation: none;
    }
  }
</style>

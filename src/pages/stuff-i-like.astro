---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import BackButton from '../components/BackButton.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/translations';

const lang = 'en';
const t = useTranslations(lang);

type StuffILikeEntry = CollectionEntry<'stuff-i-like'>;

const allInspirations: StuffILikeEntry[] = await getCollection('stuff-i-like');

const inspirations: StuffILikeEntry[] = allInspirations.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);

const allTags: string[] = [...new Set(inspirations.flatMap(item => item.data.tags))].sort();
---

<BaseLayout
  title={`${t('stuffILike.title')} — ${t('hero.name')}`}
  description={t('stuffILike.description')}
  lang={lang}
>
  <BackButton href="/" label={`← ${t('nav.home')}`} />
  <ThemeToggle />

  <main class="container">

    <header class="page-header">
      <h1>{t('stuffILike.title')}</h1>
      <p class="subtitle">{t('stuffILike.description')}</p>
    </header>

    <div class="tag-filters">
      {allTags.map((tag: string) => (
        <button class="tag-btn tag-filter" data-tag={tag}>
          {tag}
        </button>
      ))}
    </div>

    <div class="inspiration-grid">
      {inspirations.map((item: StuffILikeEntry) => (
        <article
          class="inspiration-card"
          data-tags={item.data.tags.join(',')}
        >
          {item.data.image && (
            <div class="card-image">
              <img src={item.data.image} alt={item.data.title} />
            </div>
          )}
          <div class="card-content">
            <div class="card-meta">
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toLocaleDateString(lang, {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>
            </div>

            <h2 class="card-title">
              <a href={`/stuff-i-like/${item.id}`}>
                {item.data.title}
              </a>
            </h2>

            <div class="card-tags">
              {item.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <div class="card-actions">
              <a href={`/stuff-i-like/${item.id}`} class="btn-secondary">
                {t('stuffILike.readMore')}
              </a>
              <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
                {t('stuffILike.visitLink')}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <Footer lang={lang} />
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    padding-top: 5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
    margin-bottom: 3rem;
    padding: 0;
  }

  @media (max-width: 768px) {
    .container {
      padding-top: 4rem;
    }
  }

  .tag-btn {
    padding: 0.25rem 0.625rem;
    border: none;
    background: transparent;
    color: var(--fg-muted);
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 400;
    cursor: pointer;
    transition: all var(--transition);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }

  .tag-btn:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .tag-btn.active {
    color: var(--fg);
    text-decoration-color: var(--fg);
    font-weight: 500;
  }

  .inspiration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .inspiration-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .inspiration-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .inspiration-card.hidden {
    display: none;
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--color-surface-hover);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 1.5rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    font-size: 0.75rem;
  }

  time {
    color: var(--color-text-secondary);
  }

  .card-title {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .card-title a::after {
    display: none;
  }

  .card-title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    padding: 0.25rem 0.625rem;
    background: transparent;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 0;
    font-size: 0.75rem;
  }

  .card-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-primary,
  .btn-secondary {
    padding: 0.625rem 1.25rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    flex: 1;
    text-align: center;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-surface-hover);
  }

  @media (max-width: 768px) {
    .inspiration-grid {
      grid-template-columns: 1fr;
    }

    .page-header h1 {
      font-size: 2rem;
    }

  }
</style>

<script>
  const tagFilters = document.querySelectorAll('.tag-filter');
  const inspirationCards = document.querySelectorAll('.inspiration-card');

  let selectedTags: Set<string> = new Set();

  function applyFilters() {
    inspirationCards.forEach((card: Element) => {
      const cardTags = card.getAttribute('data-tags')?.split(',') || [];

      const tagsMatch = selectedTags.size === 0 ||
        Array.from(selectedTags).every((tag: string) => cardTags.includes(tag));

      if (tagsMatch) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  tagFilters.forEach((button: Element) => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');

      if (tag) {
        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
          button.classList.remove('active');
        } else {
          selectedTags.add(tag);
          button.classList.add('active');
        }
      }

      applyFilters();
    });
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<BaseLayout
  title="한국어 페이지"
  description="한국어 easter egg page for lucas martinez"
  lang="ko"
  noindex
>
  <SiteHeader currentLang="kr" />

  <main class="container joke">
    <h1 class="page-title">한국어를 못해서 미안해요</h1>
    <p class="page-subtitle">¯\_(ツ)_/¯</p>
  </main>
</BaseLayout>

<style>
  .joke {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    animation: fadeUp 0.7s ease both;
  }

  /* Hangul glyphs are full-width, so the shared 64px title overflows the column. */
  .page-title {
    font-size: clamp(28px, 7vw, 44px);
    letter-spacing: normal;
    word-break: keep-all;
  }

  @media (prefers-reduced-motion: reduce) {
    .joke {
      animation: none;
    }
  }
</style>

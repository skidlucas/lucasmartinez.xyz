---
import TimelineRow from './TimelineRow.astro';
import { useTranslations, type Language } from '../i18n/translations';
import { getExperiences } from '../data/profile';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const experiences = getExperiences(t);
---

<section id="experiences" class="timeline">
  <h2 class="section-title">{t('experiences.title')}</h2>
  {experiences.map((exp) => (
    <TimelineRow
      variant="inline"
      years={exp.period}
      title={exp.title}
      subtitle={`${exp.company} — ${exp.workmode}`}
      desc={exp.description}
      tagline={exp.tags.join(' · ')}
    />
  ))}
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>

---
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const experiences = [
  {
    title: t('experiences.graneet.title'),
    company: t('experiences.graneet.company'),
    workmode: t('experiences.graneet.workmode'),
    period: t('experiences.graneet.period'),
    description: t('experiences.graneet.description'),
    tags: ['nestjs', 'react', 'typescript', 'postgresql', 'aws', 'ci/cd']
  },
  {
    title: t('experiences.lizee.title'),
    company: t('experiences.lizee.company'),
    workmode: t('experiences.lizee.workmode'),
    period: t('experiences.lizee.period'),
    description: t('experiences.lizee.description'),
    tags: ['nestjs', 'react', 'typescript', 'postgresql', 'ci/cd']
  },
  {
    title: t('experiences.mesdocteurs.title'),
    company: t('experiences.mesdocteurs.company'),
    workmode: t('experiences.mesdocteurs.workmode'),
    period: t('experiences.mesdocteurs.period'),
    description: t('experiences.mesdocteurs.description'),
    tags: ['angular', 'nodejs', 'postgresql', 'ci/cd']
  },
  {
    title: t('experiences.sap.title'),
    company: t('experiences.sap.company'),
    workmode: t('experiences.sap.workmode'),
    period: t('experiences.sap.period'),
    description: t('experiences.sap.description'),
    tags: ['python', 'research']
  }
];
---

<section id="experiences" class="section">
  <div class="container">
    <h2 class="section-title">{t('experiences.title')}</h2>
    <div class="experiences-list">
      {experiences.map(exp => (
        <article class="experiences">
          <div class="experiences-header">
            <div class="experiences-title-group">
              <h3 class="experiences-title">{exp.title}</h3>
              <span class="experiences-company">{exp.company} — {exp.workmode}</span>
            </div>
            <span class="experiences-period">{exp.period}</span>
          </div>
          <p class="experiences-description">{exp.description}</p>
          <div class="experiences-tags">
            {exp.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 8rem 0;
  }

  .section-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    font-weight: 400;
  }

  .experiences-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .experiences {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    transition: transform var(--transition);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .experiences.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .experiences:hover {
    transform: translateX(4px) translateY(0);
  }

  .experiences-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .experiences-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .experiences-title {
    font-size: 1.25rem;
    font-weight: 400;
  }

  .experiences-company {
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .experiences-period {
    color: var(--fg-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .experiences-description {
    color: var(--fg-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .experiences-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--fg-muted);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem 0;
    }

    .experiences-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.experiences').forEach(exp => {
    observer.observe(exp);
  });
</script>

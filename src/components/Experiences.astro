---
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

interface Experience {
  title: string;
  company: string;
  workmode: string;
  period: string;
  description: string;
  tags: string[];
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const experiences: Experience[] = [
  {
    title: t('experiences.graneet.title'),
    company: t('experiences.graneet.company'),
    workmode: t('experiences.graneet.workmode'),
    period: t('experiences.graneet.period'),
    description: t('experiences.graneet.description'),
    tags: ['nestjs', 'react', 'typescript', 'postgresql', 'aws', 'ci/cd']
  },
  {
    title: t('experiences.lizee.title'),
    company: t('experiences.lizee.company'),
    workmode: t('experiences.lizee.workmode'),
    period: t('experiences.lizee.period'),
    description: t('experiences.lizee.description'),
    tags: ['nestjs', 'react', 'typescript', 'postgresql', 'ci/cd']
  },
  {
    title: t('experiences.mesdocteurs.title'),
    company: t('experiences.mesdocteurs.company'),
    workmode: t('experiences.mesdocteurs.workmode'),
    period: t('experiences.mesdocteurs.period'),
    description: t('experiences.mesdocteurs.description'),
    tags: ['angular', 'nodejs', 'postgresql', 'ci/cd']
  },
  {
    title: t('experiences.sap.title'),
    company: t('experiences.sap.company'),
    workmode: t('experiences.sap.workmode'),
    period: t('experiences.sap.period'),
    description: t('experiences.sap.description'),
    tags: ['python', 'research']
  }
];
---

<section id="experiences" class="section">
  <div class="container">
    <h2 class="section-title">{t('experiences.title')}</h2>
    <div class="experiences-list">
      {experiences.map((exp: Experience) => (
        <article class="experiences" data-reveal>
          <div class="experiences-header">
            <div class="experiences-title-group">
              <h3 class="experiences-title">{exp.title}</h3>
              <span class="experiences-company">{exp.company} — {exp.workmode}</span>
            </div>
            <span class="experiences-period">{exp.period}</span>
          </div>
          <p class="experiences-description">{exp.description}</p>
          <div class="experiences-tags">
            {exp.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experiences-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-left: 2rem;
  }

  .experiences-list::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .experiences {
    position: relative;
    padding-left: 2rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .experiences.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .experiences:hover {
    transform: translateX(4px);
  }

  .experiences-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .experiences-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .experiences-title {
    font-size: 1.25rem;
    font-weight: 400;
  }

  .experiences-company {
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .experiences-period {
    color: var(--fg-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .experiences-description {
    color: var(--fg-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .experiences-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--fg-muted);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .experiences-list {
      padding-left: 1.5rem;
    }

    .experiences {
      padding-left: 1.5rem;
    }

    .experiences-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

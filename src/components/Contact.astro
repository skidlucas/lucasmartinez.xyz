---
import { useTranslations, type Language } from '../i18n/translations';
import { getContactLinks } from '../data/profile';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const links = getContactLinks(t);
---

<section id="contact" class="section">
  <div class="container">
    <h2 class="section-title">{t('contact.title')}</h2>
    <div class="contact-content">
      <p class="contact-intro">{t('contact.intro')}</p>
      <div class="contact-links">
        {links.map((link) => (
          <a
            href={link.url}
            class="contact-link"
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-content {
    max-width: 600px;
  }

  .contact-intro {
    color: var(--fg-muted);
    margin-bottom: 2rem;
    font-size: 1.125rem;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-link {
    font-size: 1.25rem;
    display: inline-block;
    width: fit-content;
  }

  @media (max-width: 768px) {
    .contact-links {
      gap: 0.75rem;
    }

    .contact-link {
      font-size: 1.125rem;
    }
  }
</style>

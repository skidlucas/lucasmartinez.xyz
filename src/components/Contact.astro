---
import { useTranslations, type Language } from '../i18n/translations';

interface Link {
  label: string;
  url: string;
}

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const links: Link[] = [
  { label: t('contact.email'), url: "mailto:lucasmartinez.it@gmail.com" },
  { label: t('contact.github'), url: "https://github.com/skidlucas" },
  { label: t('contact.linkedin'), url: "https://www.linkedin.com/in/lucas-martinez-462336a7" }
];
---

<section id="contact" class="section">
  <div class="container">
    <h2 class="section-title">{t('contact.title')}</h2>
    <div class="contact-content">
      <p class="contact-intro">{t('contact.intro')}</p>
      <div class="contact-links">
        {links.map((link: Link) => (
          <a
            href={link.url}
            class="contact-link"
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 8rem 0;
  }

  .section-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    font-weight: 400;
  }

  .contact-content {
    max-width: 600px;
  }

  .contact-intro {
    color: var(--fg-muted);
    margin-bottom: 2rem;
    font-size: 1.125rem;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-link {
    font-size: 1.25rem;
    display: inline-block;
    width: fit-content;
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem 0;
    }

    .contact-links {
      gap: 0.75rem;
    }

    .contact-link {
      font-size: 1.125rem;
    }
  }
</style>

---
import TimelineRow from './TimelineRow.astro';
import { useTranslations, type Language } from '../i18n/translations';
import { getEducation } from '../data/profile';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const education = getEducation(t);
---

<section id="education" class="timeline">
  <h2 class="section-title">{t('education.title')}</h2>
  {education.map((edu) => (
    <TimelineRow
      variant="stacked"
      years={edu.period}
      title={edu.degree}
      subtitle={edu.specialization ? `${edu.school} — ${edu.specialization}` : edu.school}
    />
  ))}
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>

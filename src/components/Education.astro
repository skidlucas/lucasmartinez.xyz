---
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

interface EducationItem {
  degree: string;
  school: string;
  period: string;
  specialization?: string;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const education: EducationItem[] = [
  {
    degree: t('education.polytech.degree'),
    school: t('education.polytech.school'),
    period: t('education.polytech.period'),
    specialization: t('education.polytech.specialization')
  },
  {
    degree: t('education.iut.degree'),
    school: t('education.iut.school'),
    period: t('education.iut.period')
  }
];
---

<section id="education" class="section">
  <div class="container">
    <h2 class="section-title">{t('education.title')}</h2>
    <div class="education-list">
      {education.map((edu: EducationItem) => (
        <article class="education-item">
          <div class="education-header">
            <div class="education-title-group">
              <h3 class="education-degree">{edu.degree}</h3>
              <span class="education-school">{edu.school}</span>
              {edu.specialization && (
                <span class="education-specialization">{edu.specialization}</span>
              )}
            </div>
            <span class="education-period">{edu.period}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 8rem 0;
  }

  .section-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    font-weight: 400;
  }

  .education-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-left: 2rem;
  }

  .education-list::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .education-item {
    position: relative;
    padding-left: 2rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .education-item::before {
    content: '';
    position: absolute;
    left: -0.375rem;
    top: 0.5rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--fg-default);
    background: var(--bg-default);
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .education-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .education-item:hover {
    transform: translateX(4px);
  }

  .education-item:hover::before {
    transform: scale(1.3);
    background: var(--fg-default);
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .education-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .education-degree {
    font-size: 1.125rem;
    font-weight: 400;
  }

  .education-school {
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .education-specialization {
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-style: italic;
  }

  .education-period {
    color: var(--fg-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem 0;
    }

    .education-list {
      padding-left: 1.5rem;
    }

    .education-item {
      padding-left: 1.5rem;
    }

    .education-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const observerOptions: IntersectionObserverInit = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
    entries.forEach((entry: IntersectionObserverEntry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.education-item').forEach((item: Element) => {
    observer.observe(item);
  });
</script>

---
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const tagline = t('hero.tagline');
---

<section id="hero" class="hero container">
  <h1 class="page-title hero-title">{t('hero.name')}</h1>
  <p class="page-subtitle hero-subtitle" lang="en">{t('hero.title')}</p>
  <p class="tagline" lang="en">
    <span class="sr-only">{tagline}</span>
    <span aria-hidden="true" data-typed={tagline}><noscript>{tagline}</noscript></span>
    <span class="cursor" aria-hidden="true"></span>
  </p>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    animation: fadeUp 0.7s ease both;
  }

  .hero-subtitle {
    margin-top: 14px;
    animation: fadeUp 0.7s 0.12s ease both;
  }

  .tagline {
    margin-top: 28px;
    min-height: 24px;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 17px;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--fg);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subtitle {
      animation: none;
    }
  }
</style>

<script>
  const target = document.querySelector<HTMLElement>('[data-typed]');
  const text = target?.dataset.typed ?? '';

  if (target) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      target.textContent = text;
    } else {
      let index = 0;
      const typeNext = () => {
        index++;
        target.textContent = text.slice(0, index);
        if (index < text.length) setTimeout(typeNext, 40 + Math.random() * 50);
      };
      setTimeout(typeNext, 700);
    }
  }
</script>

---
import { languageLinks, type LanguageLink } from '../i18n/translations';

interface Props {
  currentLang: LanguageLink;
}

const { currentLang }: Props = Astro.props;
const otherLangs = Object.keys(languageLinks).filter(lang => lang !== currentLang) as LanguageLink[];

const langLabels: Record<string, string> = {
  en: 'EN',
  fr: 'FR',
  kr: '한'
};

// Simple routing for homepage only (EN <-> FR, + KR easter egg)
function getLangPath(targetLang: LanguageLink): string {
  if (targetLang === 'en') return '/';
  return `/${targetLang}/`;
}
---

<div class="language-toggle">
  {otherLangs.map((lang: LanguageLink) => (
    <a
      href={getLangPath(lang)}
      class="lang-link"
      data-lang={lang}
      aria-label={languageLinks[lang]}
    >
      {langLabels[lang]}
    </a>
  ))}
</div>

<style>
  .language-toggle {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 100;
  }

  .lang-link {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    font-size: 0.875rem;
    transition: all var(--transition);
    background: var(--bg);
  }

  .lang-link::after {
    display: none;
  }

  .lang-link:hover {
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 768px) {
    .language-toggle {
      top: 1rem;
      left: 1rem;
    }
  }
</style>

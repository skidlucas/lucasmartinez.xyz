---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experiences from './Experiences.astro';
import Education from './Education.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import KonamiCode from './KonamiCode.astro';
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('hero.name')} — ${t('hero.title')}`}
  description={t('hero.tagline')}
  lang={lang}
>
  <KonamiCode />
  <ThemeToggle />
  <LanguageToggle currentLang={lang} />

  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <Experiences lang={lang} />
    <Projects lang={lang} />
    <Education lang={lang} />
    <Contact lang={lang} />
    <Footer lang={lang} />
  </main>
</BaseLayout>

<style>
  main {
    min-height: 100vh;
  }
</style>

<script>
  document.querySelectorAll('a[href^="#"]').forEach((anchor: Element) => {
    anchor.addEventListener('click', (e: Event) => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      const target = href ? document.querySelector(href) : null;
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>

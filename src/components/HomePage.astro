---
import HomeShell from '../layouts/HomeShell.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experiences from './Experiences.astro';
import Education from './Education.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

<HomeShell
  title={`${t('hero.name')} — ${t('hero.title')}`}
  description={t('hero.tagline')}
  lang={lang}
>
  <Hero lang={lang} />
  <div class="container sections">
    <About lang={lang} />
    <Experiences lang={lang} />
    <Projects lang={lang} />
    <Education lang={lang} />
    <Contact lang={lang} />
  </div>
</HomeShell>

<style>
  .sections {
    display: flex;
    flex-direction: column;
    gap: 80px;
    padding-top: 40px;
    padding-bottom: 120px;
  }
</style>

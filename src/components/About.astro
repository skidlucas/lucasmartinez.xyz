---
import { useTranslations, type Language } from '../i18n/translations';
import { skills } from '../data/profile';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="about">
  <h2 class="section-title">{t('about.title')}</h2>
  <p>{t('about.paragraph1')}</p>
  <p class="secondary">{t('about.paragraph2')}</p>
  <ul class="skills">
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  p {
    text-wrap: pretty;
  }

  .secondary {
    color: var(--text-3);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
    list-style: none;
  }

  .skill {
    border: 1px solid var(--pill-border);
    padding: 0 8px;
    font-size: 12px;
    color: var(--pill-text);
  }
</style>

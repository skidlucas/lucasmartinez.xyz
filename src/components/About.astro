---
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const skills: string[] = [
  "javascript", "typescript", "nestjs", "react",
  "postgresql", "aws", "git", "datadog", "ci/cd"
];
---

<section id="about" class="section">
  <div class="container">
    <h2 class="section-title">{t('about.title')}</h2>
    <div class="about-content">
      <p>{t('about.paragraph1')}</p>
      <p>{t('about.paragraph2')}</p>
      <div class="skills">
        {skills.map((skill: string) => (
          <span class="skill">{skill}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 8rem 0;
  }

  .section-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    font-weight: 400;
  }

  .about-content {
    max-width: 600px;
  }

  .about-content p {
    margin-bottom: 1.5rem;
    color: var(--fg-muted);
    line-height: 1.8;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .skill {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    font-size: 0.875rem;
    transition: all var(--transition);
  }

  .skill:hover {
    background: var(--fg);
    color: var(--bg);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem 0;
    }
  }
</style>

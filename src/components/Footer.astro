---
import { useTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <slot />
  <p class="copyright">© {currentYear} {t('hero.name')}. {t('footer.copyright')}</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 32px;
    font-size: 12px;
    color: var(--fg-muted);
  }

  .copyright {
    font-size: 11px;
  }
</style>

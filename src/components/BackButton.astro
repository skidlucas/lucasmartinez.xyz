---
interface Props {
  href: string;
  label?: string;
}

const { href, label = '← home' }: Props = Astro.props;
---

<a href={href} class="back-button">
  {label}
</a>

<style>
  .back-button {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
    z-index: 50;
  }

  .back-button:hover {
    color: var(--fg);
  }

  @media (max-width: 768px) {
    .back-button {
      top: 1rem;
      left: 1rem;
    }
  }
</style>

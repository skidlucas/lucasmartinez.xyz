---
interface Props {
  href: string;
  label?: string;
}

const { href, label = '← home' }: Props = Astro.props;
---

<a href={href} class="back-button" data-back-button>{label}</a>

<style>
  .back-button {
    display: inline-block;
    color: var(--fg);
    transition: transform var(--transition);
  }

  .back-button:hover {
    transform: translateX(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-button {
      transition: none;
    }
  }
</style>

<script>
  // Sub-pages are English-only and link back to `/` by default; send visitors
  // who came from the French home page back to `/fr/` instead.
  const backButton = document.querySelector<HTMLAnchorElement>('[data-back-button]');

  if (backButton && document.referrer) {
    const referrer = new URL(document.referrer);
    if (referrer.origin === location.origin && referrer.pathname.startsWith('/fr/')) {
      backButton.href = '/fr/';
    }
  }
</script>

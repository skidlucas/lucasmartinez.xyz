---

<style is:global>
  @keyframes rainbow {
    0% { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }

  @keyframes wobble {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(0.5deg); }
    75% { transform: rotate(-0.5deg); }
  }

  @keyframes bg-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  body.goofy-mode {
    font-family: 'Comic Sans MS', 'Comic Sans', cursive !important;
    background: linear-gradient(45deg, #ff00ff, #00ffff, #ffff00, #ff00ff, #ff00ff) !important;
    background-size: 400% 400% !important;
    animation: rainbow 3s linear infinite, wobble 1s ease-in-out infinite, bg-shift 5s ease infinite !important;
  }

  body.goofy-mode * {
    font-family: 'Comic Sans MS', 'Comic Sans', cursive !important;
  }

  body.goofy-mode .container {
    text-shadow: 2px 2px 0 #ff00ff, -2px -2px 0 #00ffff !important;
  }

  body.goofy-mode a {
    text-decoration: underline wavy #ff00ff !important;
  }
</style>

<script>
  const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let konamiIndex = 0;

  document.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    const expected = konamiCode[konamiIndex].toLowerCase();

    if (key === expected) {
      konamiIndex++;

      if (konamiIndex === konamiCode.length) {
        document.body.classList.toggle('goofy-mode');
        konamiIndex = 0;
      }
    } else {
      konamiIndex = 0;
    }
  });
</script>

---
interface Props {
  years: string;
  title: string;
  subtitle: string;
  desc?: string;
  tagline?: string;
  variant: 'inline' | 'stacked';
}

const { years, title, subtitle, desc, tagline, variant }: Props = Astro.props;
---

<article class="timeline-row">
  <div class="years">{years}</div>
  <div class="content">
    {variant === 'inline' ? (
      <div><h3 class="title">{title}</h3> <span class="subtitle">· {subtitle}</span></div>
    ) : (
      <div><h3 class="title">{title}</h3><div class="subtitle">{subtitle}</div></div>
    )}
    {desc && <p class="desc">{desc}</p>}
    {tagline && <p class="tagline">{tagline}</p>}
  </div>
</article>

<style>
  .timeline-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 20px;
  }

  .years {
    padding-top: 2px;
    font-size: 12px;
    color: var(--fg-muted);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title {
    display: inline;
    font-size: inherit;
    font-weight: 700;
  }

  .subtitle {
    color: var(--fg-muted);
  }

  .desc {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .tagline {
    font-size: 12px;
    color: var(--fg-muted);
  }

  @media (max-width: 639px) {
    .timeline-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>

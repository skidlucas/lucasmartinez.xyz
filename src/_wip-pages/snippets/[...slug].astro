---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import BackButton from '../../components/BackButton.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/translations';

type SnippetEntry = CollectionEntry<'snippets'>;

export async function getStaticPaths() {
  const snippetsEntries: SnippetEntry[] = await getCollection('snippets');
  return snippetsEntries.map((entry: SnippetEntry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: SnippetEntry;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  title={`${entry.data.title} — ${t('snippets.title')}`}
  description={entry.data.title}
  lang={lang}
>
  <BackButton href="/snippets" label={`← ${t('snippets.title')}`} />
  <ThemeToggle />

  <main class="container">

    <article class="snippets-detail">
      <header class="article-header">
        <div class="meta">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString(lang, {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
        </div>

        <h1>{entry.data.title}</h1>

        <div class="tags">
          {entry.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <div class="content">
        <Content />
      </div>

      <div class="actions">
        <a
          href={entry.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          {t('snippets.visitLink')} →
        </a>
      </div>
    </article>

    <Footer lang={lang} />
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    padding-top: 5rem;
  }

  .snippets-detail {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 4rem;
  }

  .hero-image {
    width: 100%;
    height: 400px;
    overflow: hidden;
    background: var(--color-surface-hover);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-header {
    padding: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  time {
    color: var(--color-text-secondary);
  }

  .article-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    line-height: 1.2;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.625rem;
    background: transparent;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 0;
    font-size: 0.75rem;
  }

  .content {
    padding: 2rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
  }

  .content :global(h2) {
    font-size: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .content :global(h3) {
    font-size: 1.375rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .content :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-primary);
    transition: opacity 0.2s;
  }

  .content :global(a:hover) {
    opacity: 0.8;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface-hover);
    font-style: italic;
  }

  .content :global(code) {
    background: var(--color-surface-hover);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .content :global(pre) {
    background: var(--color-surface-hover);
    padding: 1rem;
    border-radius: 0.375rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  .actions {
    padding: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
  }

  .btn-primary {
    padding: 0.875rem 2rem;
    background: var(--color-primary);
    color: white;
    border-radius: 0.375rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .container {
      padding-top: 4rem;
    }

    .article-header h1 {
      font-size: 1.75rem;
    }

    .hero-image {
      height: 250px;
    }
  }
</style>
